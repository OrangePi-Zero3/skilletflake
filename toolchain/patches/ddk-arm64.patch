-#if !defined(_M_AMD64)
+#if defined(__aarch64__) || defined(_M_ARM64)
+/*
+ * panfrost-win: ARM64 has no I/O ports and ntoskrnl does not export READ/WRITE_REGISTER_* on
+ * ARM64 (the WDK inlines them), so provide inline versions. Ordering follows Linux readl/writel:
+ * a write is preceded by "dmb oshst" (prior normal-memory writes, e.g. command buffers, are
+ * visible to the device first); a read is followed by "dmb oshld" (later normal-memory reads
+ * are not hoisted above it). Accesses are single aligned loads/stores, as Device memory needs.
+ */
+#define __PW_MMIO_RD(_n, _t, _insn, _reg) \
+FORCEINLINE _t READ_REGISTER_##_n(IN volatile _t *Register) \
+{ \
+  _t v; \
+  __asm__ __volatile__(_insn " %" _reg "0, [%1]" : "=r"(v) : "r"(Register) : "memory"); \
+  __asm__ __volatile__("dmb oshld" ::: "memory"); \
+  return v; \
+}
+#define __PW_MMIO_WR(_n, _t, _insn, _reg) \
+FORCEINLINE VOID WRITE_REGISTER_##_n(IN volatile _t *Register, IN _t Value) \
+{ \
+  __asm__ __volatile__("dmb oshst" ::: "memory"); \
+  __asm__ __volatile__(_insn " %" _reg "0, [%1]" : : "rZ"(Value), "r"(Register) : "memory"); \
+}
+__PW_MMIO_RD(UCHAR, UCHAR, "ldrb", "w")
+__PW_MMIO_RD(USHORT, USHORT, "ldrh", "w")
+__PW_MMIO_RD(ULONG, ULONG, "ldr", "w")
+__PW_MMIO_RD(ULONG64, ULONG64, "ldr", "x")
+__PW_MMIO_WR(UCHAR, UCHAR, "strb", "w")
+__PW_MMIO_WR(USHORT, USHORT, "strh", "w")
+__PW_MMIO_WR(ULONG, ULONG, "str", "w")
+__PW_MMIO_WR(ULONG64, ULONG64, "str", "x")
+#undef __PW_MMIO_RD
+#undef __PW_MMIO_WR
+#define __PW_MMIO_BUF(_n, _t) \
+FORCEINLINE VOID READ_REGISTER_BUFFER_##_n(IN volatile _t *Register, OUT _t *Buffer, IN ULONG Count) \
+{ \
+  while (Count--) *Buffer++ = READ_REGISTER_##_n(Register++); \
+} \
+FORCEINLINE VOID WRITE_REGISTER_BUFFER_##_n(IN volatile _t *Register, IN _t *Buffer, IN ULONG Count) \
+{ \
+  while (Count--) WRITE_REGISTER_##_n(Register++, *Buffer++); \
+}
+__PW_MMIO_BUF(UCHAR, UCHAR)
+__PW_MMIO_BUF(USHORT, USHORT)
+__PW_MMIO_BUF(ULONG, ULONG)
+#undef __PW_MMIO_BUF
+#elif !defined(_M_AMD64)
 NTHALAPI
 VOID
 NTAPI
