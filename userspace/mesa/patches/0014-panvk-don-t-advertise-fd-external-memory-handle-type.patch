From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ExposureMG <exposuremg@protonmail.com>
Date: Fri, 30 Oct 2026 01:59:59 +0000
Subject: [PATCH 14/14] panvk: don't advertise fd external memory handle types
 on Windows

VK_KHR_external_memory_fd and VK_EXT_external_memory_dma_buf are not
exposed on Windows, but vkGetPhysicalDeviceExternalBufferProperties()
and the external image format query still reported OPAQUE_FD/DMA_BUF as
importable/exportable. Report no fd handle types there.

Generated-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/panvk_physical_device.c | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_physical_device.c b/src/panfrost/vulkan/panvk_physical_device.c
index dd200b7..555ba61 100644
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -1553,6 +1553,15 @@ unsupported:
    return VK_ERROR_FORMAT_NOT_SUPPORTED;
 }
 
+/* There are no dma-buf or opaque memory fds on Windows. */
+#if DETECT_OS_WINDOWS
+#define PANVK_EXTERNAL_MEMORY_FD_HANDLE_TYPES 0
+#else
+#define PANVK_EXTERNAL_MEMORY_FD_HANDLE_TYPES                                  \
+   (VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT |                             \
+    VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT)
+#endif
+
 static VkResult
 panvk_get_external_image_format_properties(
    const struct panvk_physical_device *physical_device,
@@ -1561,8 +1570,7 @@ panvk_get_external_image_format_properties(
    VkExternalMemoryProperties *external_properties)
 {
    const VkExternalMemoryHandleTypeFlags supported_handle_types =
-      VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT |
-      VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+      PANVK_EXTERNAL_MEMORY_FD_HANDLE_TYPES;
 
    if (!(handleType & supported_handle_types)) {
       return panvk_errorf(physical_device, VK_ERROR_FORMAT_NOT_SUPPORTED,
@@ -1917,8 +1925,7 @@ panvk_GetPhysicalDeviceExternalBufferProperties(
    }
 
    const VkExternalMemoryHandleTypeFlags supported_handle_types =
-      VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT |
-      VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+      PANVK_EXTERNAL_MEMORY_FD_HANDLE_TYPES;
 
    /* From the Vulkan 1.3.298 spec:
     *
