From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ExposureMG <exposuremg@protonmail.com>
Date: Fri, 30 Oct 2026 01:32:57 +0000
Subject: [PATCH 03/14] vulkan/runtime: use thrd_yield() in vk_drm_syncobj

<sched.h> doesn't exist on Windows. With a libdrm-compatible library,
vk_drm_syncobj.c is the only Linux-only bit left on the Windows syncobj
path.

Generated-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/vulkan/runtime/vk_drm_syncobj.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/vulkan/runtime/vk_drm_syncobj.c b/src/vulkan/runtime/vk_drm_syncobj.c
index 57de98e..9da1cae 100644
--- a/src/vulkan/runtime/vk_drm_syncobj.c
+++ b/src/vulkan/runtime/vk_drm_syncobj.c
@@ -23,13 +23,13 @@
 
 #include "vk_drm_syncobj.h"
 
-#include <sched.h>
 #include <xf86drm.h>
 
 #include "drm-uapi/drm.h"
 
 #include "util/libsync.h"
 #include "util/os_time.h"
+#include "c11/threads.h"
 #include "util/u_sync_provider.h"
 
 #include "vk_device.h"
@@ -255,7 +255,7 @@ spin_wait_for_sync_file(struct vk_device *device,
          if (os_time_get_nano() >= abs_timeout_ns)
             return VK_TIMEOUT;
 
-         sched_yield();
+         thrd_yield();
       }
    } else {
       for (uint32_t i = 0; i < wait_count; i++) {
@@ -270,7 +270,7 @@ spin_wait_for_sync_file(struct vk_device *device,
             if (os_time_get_nano() >= abs_timeout_ns)
                return VK_TIMEOUT;
 
-            sched_yield();
+            thrd_yield();
          }
       }
    }
