From: ExposureMG <exposuremg@protonmail.com>
Date: Fri, 30 Oct 2026 01:32:57 +0000
Subject: [PATCH 02/14] util/libsync: provide failing sync_file helpers on
 Windows

There are no sync_file fds on Windows. Stub sync_wait()/sync_merge()/
sync_valid_fd() so that generic code using libsync.h (vk_drm_syncobj.c,
panthor_kmod.c) builds; the paths that reach them need a sync_file in the
first place and can't be taken.

Generated-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/util/libsync.h | 32 ++++++++++++++++++++++++++++----
 1 file changed, 28 insertions(+), 4 deletions(-)

diff --git a/src/util/libsync.h b/src/util/libsync.h
index b22b75a..38184ab 100644
--- a/src/util/libsync.h
+++ b/src/util/libsync.h
@@ -30,12 +30,10 @@
 
 #include <assert.h>
 #include <errno.h>
-#include <poll.h>
 #include <stdbool.h>
 #include <stdint.h>
 #include <string.h>
 #include <sys/types.h>
-#include <sys/ioctl.h>
 #include <unistd.h>
 #include <stdlib.h>
 #include <time.h>
@@ -43,11 +41,37 @@
 #include "util/detect_os.h"
 #include "util/os_file.h"
 
+#if !DETECT_OS_WINDOWS
+#include <poll.h>
+#include <sys/ioctl.h>
+#endif
+
 #if defined(__cplusplus)
 extern "C" {
 #endif
 
-#if DETECT_OS_ANDROID
+#if DETECT_OS_WINDOWS
+/* Windows has no sync_file. Code paths that end up here get a sync-file fd
+ * from somewhere, which can't happen, so just fail.
+ */
+static inline int sync_wait(int fd, int timeout)
+{
+	errno = ENOSYS;
+	return -1;
+}
+
+static inline int sync_merge(const char *name, int fd1, int fd2)
+{
+	errno = ENOSYS;
+	return -1;
+}
+
+static inline bool
+sync_valid_fd(int fd)
+{
+	return false;
+}
+#elif DETECT_OS_ANDROID
 /* On Android, rely on the system's libsync instead of rolling our own
  * sync_wait() and sync_merge().  This gives us compatibility with pre-4.7
  * Android kernels.
@@ -204,7 +228,7 @@ static inline struct sync_file_info* sync_file_info(int32_t fd)
     return info;
 }
 
-#endif /* DETECT_OS_ANDROID */
+#endif /* DETECT_OS_WINDOWS / DETECT_OS_ANDROID */
 
