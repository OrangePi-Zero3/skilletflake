From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ExposureMG <exposuremg@protonmail.com>
Date: Fri, 30 Oct 2026 01:32:57 +0000
Subject: [PATCH 09/14] pan/kmod: add pan_kmod_bo_munmap()

Add an optional bo_munmap op as the counterpart of bo_mmap, defaulting to
os_munmap() over the whole BO, and use it wherever panvk unmaps BO
mappings. Backends whose CPU mappings are not plain mmap()s of the DRM fd
(e.g. on Windows, where the kernel driver creates them) can then tear them
down properly. No functional change for existing backends.

Generated-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/lib/kmod/pan_kmod.h             | 16 ++++++++++++++++
 src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c |  4 ++--
 src/panfrost/vulkan/panvk_device_memory.c    |  6 +++---
 src/panfrost/vulkan/panvk_host_copy.c        |  2 +-
 src/panfrost/vulkan/panvk_image.c            |  2 +-
 src/panfrost/vulkan/panvk_priv_bo.c          |  4 ++--
 6 files changed, 25 insertions(+), 9 deletions(-)

diff --git a/src/panfrost/lib/kmod/pan_kmod.h b/src/panfrost/lib/kmod/pan_kmod.h
index 31ddc32..96b43bf 100644
--- a/src/panfrost/lib/kmod/pan_kmod.h
+++ b/src/panfrost/lib/kmod/pan_kmod.h
@@ -492,6 +492,11 @@ struct pan_kmod_ops {
    /* Map the buffer object to device memory. */
    void *(*bo_mmap)(struct pan_kmod_bo *bo, int prot, int flags, void *host_addr);
 
+   /* Unmap a CPU mapping returned by bo_mmap. This method is optional, when
+    * not specified, os_munmap() is called on the whole BO range.
+    */
+   int (*bo_munmap)(struct pan_kmod_bo *bo, void *host_addr);
+
    /* Flush the pending BO map syncs. */
    int (*flush_bo_map_syncs)(struct pan_kmod_dev *dev);
 
@@ -749,6 +754,17 @@ pan_kmod_bo_mmap(struct pan_kmod_bo *bo, int prot, int flags, void *host_addr)
    return host_addr;
 }
 
+static inline int
+pan_kmod_bo_munmap(struct pan_kmod_bo *bo, void *host_addr)
+{
+   PAN_TRACE_FUNC(PAN_TRACE_LIB_KMOD);
+
+   if (bo->dev->ops->bo_munmap)
+      return bo->dev->ops->bo_munmap(bo, host_addr);
+
+   return os_munmap(host_addr, bo->size);
+}
+
 static inline bool
 pan_kmod_can_sync_bo_map_from_userland(struct pan_kmod_dev *dev)
 {
