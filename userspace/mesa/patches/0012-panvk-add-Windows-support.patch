+#if DETECT_OS_WINDOWS
+/* The device nodes are synthesized by libdrm-win. */
+static VkResult
+get_drm_device_ids(struct panvk_physical_device *device,
+                   const struct panvk_instance *instance,
+                   drmDevicePtr drm_device)
+{
+   uint64_t rdev;
+
+   if (panwin_stat_rdev(drm_device->nodes[DRM_NODE_RENDER], &rdev)) {
+      return vk_errorf(instance, VK_ERROR_INITIALIZATION_FAILED,
+                       "failed to query render node stat");
+   }
+
+   device->drm.render_rdev = rdev;
+
+   if ((drm_device->available_nodes & (1 << DRM_NODE_PRIMARY)) &&
+       !panwin_stat_rdev(drm_device->nodes[DRM_NODE_PRIMARY], &rdev))
+      device->drm.primary_rdev = rdev;
+
+   return VK_SUCCESS;
+}
+#else
