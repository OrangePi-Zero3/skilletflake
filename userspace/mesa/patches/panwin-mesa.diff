diff --git a/src/util/os_mman_win32.c b/src/util/os_mman_win32.c
new file mode 100644
index 0000000..5d50ab5
--- /dev/null
+++ b/src/util/os_mman_win32.c
@@ -0,0 +1,85 @@
+/*
+ * Copyright © 2026 panfrost-win contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Windows implementation of the anonymous-memory subset of os_mman.h. */
+
+#include <errno.h>
+
+#include <windows.h>
+
+#include "util/os_mman.h"
+
+static DWORD
+prot_to_page_protect(int prot)
+{
+   if (prot & PROT_EXEC) {
+      if (prot & PROT_WRITE)
+         return PAGE_EXECUTE_READWRITE;
+      return (prot & PROT_READ) ? PAGE_EXECUTE_READ : PAGE_EXECUTE;
+   }
+
+   if (prot & PROT_WRITE)
+      return PAGE_READWRITE;
+
+   return (prot & PROT_READ) ? PAGE_READONLY : PAGE_NOACCESS;
+}
+
+void *
+os_mmap(void *addr, size_t length, int prot, int flags, int fd,
+        int64_t offset)
+{
+   if (!(flags & MAP_ANONYMOUS) || fd != -1 || offset != 0) {
+      errno = ENODEV;
+      return MAP_FAILED;
+   }
+
+   if (length == 0) {
+      errno = EINVAL;
+      return MAP_FAILED;
+   }
+
+   /* VirtualAlloc() cannot replace an existing mapping, so MAP_FIXED only
+    * works on free address ranges. Without MAP_FIXED, addr is a hint and
+    * ignored, like on Linux.
+    */
+   void *hint = (flags & MAP_FIXED) ? addr : NULL;
+   DWORD type = MEM_RESERVE | (prot != PROT_NONE ? MEM_COMMIT : 0);
+   void *ptr = VirtualAlloc(hint, length, type, prot_to_page_protect(prot));
+
+   if (!ptr) {
+      errno = (flags & MAP_FIXED) ? EINVAL : ENOMEM;
+      return MAP_FAILED;
+   }
+
+   return ptr;
+}
+
+int
+os_munmap(void *addr, size_t length)
+{
+   MEMORY_BASIC_INFORMATION info;
+
+   /* Only whole allocations made by os_mmap() can be released. */
+   if (!VirtualQuery(addr, &info, sizeof(info)) ||
+       info.AllocationBase != addr || !VirtualFree(addr, 0, MEM_RELEASE)) {
+      errno = EINVAL;
+      return -1;
+   }
+
+   return 0;
+}
+
+int
+os_mprotect(void *addr, size_t length, int prot)
+{
+   DWORD old;
+
+   if (!VirtualProtect(addr, length, prot_to_page_protect(prot), &old)) {
+      errno = EACCES;
+      return -1;
+   }
+
+   return 0;
+}
