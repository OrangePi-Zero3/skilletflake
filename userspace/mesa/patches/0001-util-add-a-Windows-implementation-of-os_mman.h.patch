+/* Only the subset of mmap() that can be emulated with VirtualAlloc() is
+ * supported: anonymous, private mappings. File/device-backed mappings fail
+ * with ENODEV; drivers must map device memory through their KMD interface.
+ * The flag values match Linux.
+ */
+#  ifndef PROT_NONE
+#    define PROT_NONE  0x0
+#    define PROT_READ  0x1
+#    define PROT_WRITE 0x2
+#    define PROT_EXEC  0x4
+#  endif
+#  ifndef MAP_SHARED
+#    define MAP_SHARED    0x01
+#    define MAP_PRIVATE   0x02
+#    define MAP_FIXED     0x10
+#    define MAP_ANONYMOUS 0x20
+#  endif
+#  ifndef MAP_FAILED
+#    define MAP_FAILED ((void *)-1)
+#  endif
 #else
 #  error Unsupported OS
 #endif
