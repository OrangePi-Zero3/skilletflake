+/* Open/dup/close a DRM device fd. */
+static inline int
+pan_kmod_fd_open(const char *path)
+{
+#if DETECT_OS_WINDOWS
+   return panwin_open(path, O_RDWR);
+#else
+   return open(path, O_RDWR | O_CLOEXEC);
+#endif
+}
+
+static inline int
+pan_kmod_fd_dup(int fd)
+{
+#if DETECT_OS_WINDOWS
+   return panwin_dup(fd);
+#else
+   return os_dupfd_cloexec(fd);
+#endif
+}
+
+static inline int
+pan_kmod_fd_close(int fd)
+{
+#if DETECT_OS_WINDOWS
+   return panwin_close(fd);
+#else
+   return close(fd);
+#endif
+}
