-                                   DRM_PANTHOR_USER_FLUSH_ID_MMIO_OFFSET);
+   panthor_dev->flush_id =
+      panthor_kmod_mmap(NULL, panthor_kmod_flush_id_map_size(), PROT_READ,
+                        MAP_SHARED, fd, DRM_PANTHOR_USER_FLUSH_ID_MMIO_OFFSET);
    if (panthor_dev->flush_id == MAP_FAILED) {
       mesa_loge("failed to mmap the LATEST_FLUSH_ID register (err=%d)", errno);
       goto err_free_dev;
@@ -357,7 +399,7 @@ panthor_kmod_dev_destroy(struct pan_kmod_dev *dev)
    struct panthor_kmod_dev *panthor_dev =
