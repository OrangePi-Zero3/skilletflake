 const struct pan_kmod_ops panthor_kmod_ops;
 
+/* CPU mappings of DRM fd offsets (BOs and the user MMIO page). */
+static void *
+panthor_kmod_mmap(void *host_addr, size_t size, int prot, int flags, int fd,
+                  uint64_t offset)
+{
+#if DETECT_OS_WINDOWS
+   /* libdrm-win asks the KMD to map the pages, which can't replace an
+    * existing reservation.
+    */
+   if (flags & MAP_FIXED) {
+      errno = ENOTSUP;
+      return MAP_FAILED;
+   }
+
+   void *ptr = panwin_mmap(fd, offset, size, prot);
+   return ptr ? ptr : MAP_FAILED;
+#else
+   return os_mmap(host_addr, size, prot, flags, fd, offset);
+#endif
+}
+
+static int
+panthor_kmod_munmap(void *host_addr, size_t size)
+{
+#if DETECT_OS_WINDOWS
+   return panwin_munmap(host_addr, size);
+#else
+   return os_munmap(host_addr, size);
+#endif
+}
+
+static size_t
+panthor_kmod_flush_id_map_size(void)
+{
+   uint64_t page_size = 4096;
+
+   os_get_page_size(&page_size);
+   return page_size;
+}
+
 /* Objects used to track VAs returned through async unmaps. */
 struct panthor_kmod_va_collect {
    struct list_head node;
