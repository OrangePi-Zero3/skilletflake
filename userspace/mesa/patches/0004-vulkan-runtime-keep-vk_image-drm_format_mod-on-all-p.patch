From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ExposureMG <exposuremg@protonmail.com>
Date: Fri, 30 Oct 2026 01:32:57 +0000
Subject: [PATCH 04/14] vulkan/runtime: keep vk_image::drm_format_mod on all
 platforms

panvk describes all its image layouts (linear, u-interleaved, AFBC, AFRC)
with DRM format modifiers, also internally, so the field is needed on
Windows too. vk_image.c doesn't need drm_fourcc.h for it.

Generated-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/vulkan/runtime/vk_image.c | 4 ----
 src/vulkan/runtime/vk_image.h | 5 +++--
 2 files changed, 3 insertions(+), 6 deletions(-)

diff --git a/src/vulkan/runtime/vk_image.c b/src/vulkan/runtime/vk_image.c
index 474cd41..8df792f 100644
--- a/src/vulkan/runtime/vk_image.c
+++ b/src/vulkan/runtime/vk_image.c
@@ -111,9 +111,7 @@ vk_image_init(struct vk_device *device,
       vk_find_struct_const(pCreateInfo->pNext, WSI_IMAGE_CREATE_INFO_MESA);
    image->wsi_legacy_scanout = wsi_info && wsi_info->scanout;
 
-#if DETECT_OS_LINUX || DETECT_OS_BSD
    image->drm_format_mod = ((1ULL << 56) - 1) /* DRM_FORMAT_MOD_INVALID */;
-#endif
 
 #ifdef VK_USE_PLATFORM_ANDROID_KHR
    if (image->external_handle_types &
@@ -196,7 +194,6 @@ vk_image_destroy(struct vk_device *device,
    vk_object_free(device, alloc, image);
 }
 
-#if DETECT_OS_LINUX || DETECT_OS_BSD
 VKAPI_ATTR VkResult VKAPI_CALL
 vk_common_GetImageDrmFormatModifierPropertiesEXT(UNUSED VkDevice device,
                                                  VkImage _image,
@@ -212,7 +209,6 @@ vk_common_GetImageDrmFormatModifierPropertiesEXT(UNUSED VkDevice device,
 
    return VK_SUCCESS;
 }
-#endif
 
 VKAPI_ATTR void VKAPI_CALL
 vk_common_GetImageSubresourceLayout(VkDevice _device, VkImage _image,
diff --git a/src/vulkan/runtime/vk_image.h b/src/vulkan/runtime/vk_image.h
index 4518281..11c7eb2 100644
--- a/src/vulkan/runtime/vk_image.h
+++ b/src/vulkan/runtime/vk_image.h
@@ -80,7 +80,6 @@ struct vk_image {
    /* wsi_image_create_info::scanout */
    bool wsi_legacy_scanout;
 
-#if DETECT_OS_LINUX || DETECT_OS_BSD
    /* VK_EXT_drm_format_modifier
     *
     * Initialized by vk_image_create/init() to DRM_FORMAT_MOD_INVALID.  It's
@@ -89,9 +88,11 @@ struct vk_image {
     *
     * Must be DRM_FORMAT_MOD_INVALID unless tiling is
     * VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT.
+    *
+    * Kept on all platforms: drivers such as panvk use modifiers to describe
+    * their internal image layouts.
     */
    uint64_t drm_format_mod;
-#endif
 
 #ifdef VK_USE_PLATFORM_ANDROID_KHR
    enum android_buffer_type android_buffer_type;
